# Copie ce fichier en .env et remplis-le. .env est ignoré par git.

# URL racine du site, sans slash final et sans /wp-admin
WP_URL=https://monsite.fr

# Identifiant WordPress (celui de connexion, pas l'email)
WP_USER=admin

# --- Choisir UNE des deux méthodes ci-dessous ---

# 1. Recommandé : mot de passe d'application
#    (Utilisateurs > Profil > Mots de passe d'application)
#    Les espaces sont acceptés, ils sont retirés automatiquement.
WP_APP_PASSWORD=xxxx xxxx xxxx xxxx xxxx xxxx

# 2. Sinon : mot de passe de connexion normal.
#    Le script se connecte alors via wp-login.php (cookies + nonce REST),
#    comme le fait ton navigateur. Laisser WP_APP_PASSWORD vide pour l'utiliser.
# WP_PASSWORD=monmotdepasse
