# Copie ce fichier en .env et remplis-le. .env est ignoré par git.
# URL racine du site (sans slash final)
WP_URL=https://monsite.fr
# Identifiant WordPress (celui de connexion, PAS l'email)
WP_USER=admin
# Mot de passe d'application (Utilisateurs > Profil > Mots de passe d'application)
# Les espaces sont acceptés, ils sont retirés automatiquement.
WP_APP_PASSWORD=xxxx xxxx xxxx xxxx xxxx xxxx
